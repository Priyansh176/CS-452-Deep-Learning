   "outputs": [],
   "source": [
    "# Input samples\n",
    "X = np.array([[1.0], [2.0], [3.0]])\n",
    "\n",
    "# Class labels\n",
    "y = np.array([0, 1, 2])\n",
    "\n",
    "# One-hot encoding\n",
    "K = 3\n",
    "Y = np.eye(K)[y]\n",
    "\n",
    "print(\"Input:\\n\", X)\n",
    "print(\"\\nOne Hot Labels:\\n\", Y)"
   ]
  }
